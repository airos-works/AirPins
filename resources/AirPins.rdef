resource app_signature "application/x-vnd.airOS-AirPins";
resource app_flags B_SINGLE_LAUNCH;
resource vector_icon { import "airpins-icon.hvif" };
resource app_version {
	major = 1, middle = 1, minor = 0, variety = B_APPV_FINAL, internal = 0,
	short_info = "AirPins 1.1.0 — Raspberry Pi and Cubie A7S GPIO",
	long_info = "Configure, drive and watch the GPIO pins of the Raspberry Pi and the Radxa Cubie A7S. A native Haiku version of pigg by Andrew Mackenzie."
};
resource file_types message {
	"types" = "application/x-vnd.pigg-config"
};
